{
  "schema": 2,
  "permissions": [
    "storage.read",
    "storage.write",
    "tools.invoke"
  ],
  "required_executas": [
    {
      "tool_id": "bundled:mini-notes-summarizer",
      "min_version": "1.0.0",
      "version": "latest"
    }
  ],
  "optional_executas": [],
  "tags": ["notes", "productivity", "sampling"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Mini Notes",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 360, "h": 520 },
        "default_size": { "w": 520, "h": 720 },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "storage": ["get", "set"],
      "tools": ["required:bundled:mini-notes-summarizer"]
    },
    "csp_overrides": {
      "script-src": ["'self'"],
      "style-src": ["'self'"]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}

